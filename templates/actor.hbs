<div class="ucurifunke-character">
  {{#*inline "searchField"}}
    <label><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input type="search" aria-label="{{label}}" placeholder="{{label}}">
    </label>
  {{/inline}}
  {{#*inline "skillRows"}}
    {{#each groups}}
      <section class="ucurifunke-group" data-filter-group="{{name}}">
        <h3>{{name}}</h3>
        <ul class="ucurifunke-rows">
          {{#each rows}}
            <li class="ucurifunke-row {{#if specialization}}is-specialization{{/if}}"
                data-filter-row="{{../name}} {{name}} {{attributeLabel}}">
              <span class="ucurifunke-row-name">
                {{#if specialization}}<i class="fa-solid fa-turn-up" aria-hidden="true"></i>{{/if}}
                {{label}}
              </span>
              {{#if attributeLabel}}<small class="ucurifunke-row-meta">{{attributeLabel}}</small>{{/if}}
              <strong class="ucurifunke-row-value" aria-label="Wert {{value}}">{{value}}</strong>
              {{#if rollable}}{{#if @root.canRoll}}
                <button type="button" class="ucurifunke-roll" data-action="rollCheck" data-kind="skill" data-index="{{index}}"
                        title="{{name}} würfeln" aria-label="{{name}} würfeln">
                  <i class="fa-solid fa-dice-d20" aria-hidden="true"></i>
                </button>
              {{/if}}{{/if}}
              {{#if technique}}{{#if @root.canRoll}}
                {{#if ranged}}
                  <button type="button" class="ucurifunke-roll" data-action="rollCheck" data-kind="technique"
                    data-index="{{index}}" data-mode="FK" aria-label="Fernkampf mit {{name}} würfeln">FK</button>
                {{else}}
                  <button type="button" class="ucurifunke-roll" data-action="rollCheck" data-kind="technique"
                    data-index="{{index}}" data-mode="AT" aria-label="Angriff mit {{name}} würfeln">AT</button>
                  <button type="button" class="ucurifunke-roll" data-action="rollCheck" data-kind="technique"
                    data-index="{{index}}" data-mode="PA" aria-label="Parade mit {{name}} würfeln">PA</button>
                {{/if}}
              {{/if}}{{/if}}
            </li>
          {{/each}}
        </ul>
      </section>
    {{/each}}
  {{/inline}}
  {{#*inline "itemRows"}}
    {{#each groups}}
      <section class="ucurifunke-group" data-filter-group="{{name}}">
        <h3>{{name}}</h3>
        <ul class="ucurifunke-rows">
          {{#each rows}}
            <li class="ucurifunke-row is-item" data-filter-row="{{../name}} {{name}} {{data.container}} {{data.technique}}">
              <div class="ucurifunke-row-name">
                <span title="{{data.description}}">{{name}}</span>
                <small class="ucurifunke-item-details">
                  {{#if data.container}}<span>{{data.container}}</span>{{/if}}
                  {{#if data.damage}}<span>{{data.damage}}</span>{{/if}}
                  {{#if data.reach}}<span>{{data.reach}}</span>{{/if}}
                  {{#if hasSpeed}}<span>WGS {{data.speed}}</span>{{/if}}
                  {{#if hasReload}}<span>Laden {{data.reload}} Ticks</span>{{/if}}
                  {{#if data.protection}}<span>RS {{data.protection}}</span>{{/if}}
                </small>
              </div>
              <small class="ucurifunke-row-meta" aria-label="Anzahl {{data.quantity}}">×{{data.quantity}}</small>
              {{#if @root.canRoll}}
                {{#if attack}}<button type="button" class="ucurifunke-roll" data-action="rollCheck" data-kind="weapon"
                  data-item="{{id}}" data-mode="{{attackMode}}" aria-label="{{attackMode}} mit {{name}} würfeln">{{attackMode}}</button>{{/if}}
                {{#if parry}}<button type="button" class="ucurifunke-roll" data-action="rollCheck" data-kind="weapon"
                  data-item="{{id}}" data-mode="PA" aria-label="Parade mit {{name}} würfeln">PA</button>{{/if}}
              {{/if}}
            </li>
          {{/each}}
        </ul>
      </section>
    {{/each}}
  {{/inline}}

  <header class="ucurifunke-character-header">
    {{#if actorImage}}<img src="{{actorImage}}" alt="">{{/if}}
    <div class="ucurifunke-identity">
      <h2>{{actorName}}</h2>
      {{#if data.race}}<p>{{data.race}}</p>{{/if}}
    </div>
    {{#if canRollPerception}}
      <button type="button" class="ucurifunke-roll ucurifunke-perception" data-action="rollCheck" data-kind="perception"
        title="Wahrnehmung würfeln" aria-label="Wahrnehmung würfeln"><i class="fa-solid fa-eye" aria-hidden="true"></i></button>
    {{/if}}
  </header>
  <nav class="ucurifunke-sheet-tabs" role="tablist" aria-label="Charakterbogen">
    <button type="button" role="tab" id="{{sheetId}}-tab-overview" aria-controls="{{sheetId}}-overview"
            aria-selected="true" data-action="openSheetTab" data-sheet-tab="overview"><i class="fa-solid fa-id-card" aria-hidden="true"></i> Grundwerte</button>
    <button type="button" role="tab" id="{{sheetId}}-tab-combat" aria-controls="{{sheetId}}-combat"
            aria-selected="false" tabindex="-1" data-action="openSheetTab" data-sheet-tab="combat"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Kampf</button>
    {{#each skillTabs}}
      <button type="button" role="tab" id="{{@root.sheetId}}-tab-{{id}}" aria-controls="{{@root.sheetId}}-{{id}}"
        aria-selected="false" tabindex="-1" data-action="openSheetTab" data-sheet-tab="{{id}}">
        <i class="fa-solid {{icon}}" aria-hidden="true"></i> {{label}}
      </button>
    {{/each}}
  </nav>

  <div class="ucurifunke-sheet-body">
    <section role="tabpanel" id="{{sheetId}}-overview" aria-labelledby="{{sheetId}}-tab-overview" data-sheet-panel="overview" data-searchable>
      <div class="ucurifunke-filter">{{> searchField label="Grundwerte suchen"}}</div>
      {{#each attributeGroups}}
        <section class="ucurifunke-overview-group" data-filter-group="{{name}}">
          <h3>{{name}}</h3>
          <ul class="ucurifunke-attributes">
            {{#each rows}}
              <li data-filter-row="{{../name}} {{name}} {{key}}">
                <div>
                  <span>{{name}}</span><strong>{{value}}</strong>
                  {{#if rollable}}{{#if @root.canRoll}}
                    <button type="button" class="ucurifunke-roll" data-action="rollCheck" data-kind="attribute"
                      data-index="{{index}}" title="{{name}} würfeln" aria-label="{{name}} würfeln">
                      <i class="fa-solid fa-dice-d20" aria-hidden="true"></i>
                    </button>
                  {{/if}}{{/if}}
                </div>
              </li>
            {{/each}}
          </ul>
        </section>
      {{/each}}
      {{#if derivedValues.length}}
        <section class="ucurifunke-overview-group" data-filter-group="Abgeleitete Werte">
          <h3>Abgeleitete Werte</h3>
          <dl class="ucurifunke-derived">
            {{#each derivedValues}}
              <div data-filter-row="Abgeleitete Werte {{name}} {{key}}"><dt>{{name}}</dt><dd>{{value}}</dd></div>
            {{/each}}
          </dl>
        </section>
      {{/if}}
      <p class="ucurifunke-empty" role="status" data-no-results hidden>Keine passenden Grundwerte.</p>
    </section>

    <section role="tabpanel" id="{{sheetId}}-combat" aria-labelledby="{{sheetId}}-tab-combat" data-sheet-panel="combat" data-searchable hidden>
      <div class="ucurifunke-filter">{{> searchField label="Kampftechniken, Waffen und Rüstung suchen"}}</div>
      <section class="ucurifunke-group" data-filter-group="Kampfwerte">
        <h3>Kampfwerte</h3>
        <div class="ucurifunke-combat-values" data-filter-row="Kampfwerte Beeinträchtigung Reaktionsvermögen BE RE">
          <label>BE <input type="number" name="impairment" min="0" step="1" value="{{data.impairment}}" {{#unless canEdit}}disabled{{/unless}}></label>
          <label>RE <input type="number" name="reaction" min="0" step="1" value="{{data.reaction}}" {{#unless canEdit}}disabled{{/unless}}></label>
          {{#if canEdit}}<button type="button" data-action="saveCombatValues">Speichern</button>{{/if}}
        </div>
      </section>
      {{#if weaponGroups.length}}
        <section class="ucurifunke-combat-section"><h3>Waffen</h3>{{> itemRows groups=weaponGroups}}</section>
      {{/if}}
      {{#if armorGroups.length}}
        <section class="ucurifunke-combat-section">{{> itemRows groups=armorGroups}}</section>
      {{/if}}
      {{#if combatGroups.length}}
        <section class="ucurifunke-combat-section"><h3>Kampftechniken</h3>{{> skillRows groups=combatGroups}}</section>
      {{/if}}
      <p class="ucurifunke-empty" role="status" data-no-results hidden>Keine passenden Kampftechniken, Waffen oder Rüstungen.</p>
    </section>
    {{#each skillTabs}}
      <section role="tabpanel" id="{{@root.sheetId}}-{{id}}" aria-labelledby="{{@root.sheetId}}-tab-{{id}}"
        data-sheet-panel="{{id}}" data-searchable hidden>
        <div class="ucurifunke-filter">
          {{> searchField label="Fertigkeiten suchen"}}
          {{#if groups.length}}
            <select aria-label="Fertigkeitsbereich">
              <option value="">Alle Bereiche</option>
              {{#each groups}}<option value="{{name}}">{{name}}</option>{{/each}}
            </select>
          {{/if}}
        </div>
        {{> skillRows groups=groups}}
        <p class="ucurifunke-empty" role="status" data-no-results hidden>
          {{#if groups.length}}Keine passenden Fertigkeiten.{{else}}Keine Proben in diesem Bereich verfügbar.{{/if}}
        </p>
      </section>
    {{/each}}
  </div>
</div>
