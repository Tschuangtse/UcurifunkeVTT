<div class="ucurifunke-focus">
  <label>
    <span>Kampffokus</span>
    <input type="range" name="combatFocus" min="-2" max="2" step="1" value="{{focus}}"
      {{#unless canEdit}}disabled{{/unless}}>
  </label>
  <div class="ucurifunke-focus-values">
    <span>Defensiv <strong data-focus-def></strong></span>
    <span>Offensiv <strong data-focus-off></strong></span>
  </div>
</div>
